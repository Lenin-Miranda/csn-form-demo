# Local development values come from `npx supabase status`
# Production values come from your hosted Supabase project's Connect dialog

PORT=3001
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=your-local-secret-key

# Legacy fallback if your project still uses JWT-based keys
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
